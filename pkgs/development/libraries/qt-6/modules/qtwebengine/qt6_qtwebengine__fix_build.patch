Subject: [PATCH] qt6.qtwebengine: fix build
---
Index: pkgs/development/libraries/qt-6/modules/qtwebengine.nix
===================================================================
diff --git a/pkgs/development/libraries/qt-6/modules/qtwebengine.nix b/pkgs/development/libraries/qt-6/modules/qtwebengine.nix
--- a/pkgs/development/libraries/qt-6/modules/qtwebengine.nix	(revision f5625fbe4a6cd46f80454cee09f5dca3c6022ae5)
+++ b/pkgs/development/libraries/qt-6/modules/qtwebengine.nix	(revision a4f6ea89947e087d570b81bbce66f3107cd29b0c)
@@ -3,6 +3,7 @@
 , qtwebchannel
 , qtpositioning
 , qtwebsockets
+, buildPackages
 , bison
 , coreutils
 , flex
@@ -105,6 +106,9 @@
       patchShebangs .
     )
 
+    substituteInPlace cmake/Functions.cmake \
+      --replace "/bin/bash" "${buildPackages.bash}/bin/bash"
+
     sed -i -e '/lib_loader.*Load/s!"\(libudev\.so\)!"${lib.getLib systemd}/lib/\1!' \
       src/3rdparty/chromium/device/udev_linux/udev?_loader.cc
 
